# Firebase Web SDK configuration. Set these for build and Functions scopes in Netlify.
# Existing camelCase project settings are also supported (see README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# AI Gateway supplies server-side inference credentials automatically.
# Do not add provider secrets or Firebase administrative credentials to VITE_ settings.
